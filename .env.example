# CryptoQuant API access token (Bearer). Required for /api/insight.
# Get yours at https://cryptoquant.com — never commit the real value.
CRYPTOQUANT_API_KEY=

# HTTP port for Express (Railway sets PORT automatically).
PORT=3000

# Telegram bot token from @BotFather (bot/telegram_bot.py only).
TELEGRAM_BOT_TOKEN=

# Base URL of this dashboard's insight API (no trailing slash).
# Local: http://127.0.0.1:3000
# Railway: https://your-app.up.railway.app
INSIGHT_API_URL=http://127.0.0.1:3000

# Optional CoinGlass API key (same name as the TG bot). Enables Binance
# global + top-trader long/short account ratios in /api/insight.
# Header: CG-API-KEY. Never expose to the client.
CG_API_KEY=

